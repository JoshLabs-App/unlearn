{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server $PORT"
      ],
      "port": 8917,
      "autoPort": true
    },
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    }
  ]
}